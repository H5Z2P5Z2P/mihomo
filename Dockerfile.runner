FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    docker.io \
    git \
    git-lfs \
    gnupg \
    iproute2 \
    jq \
    libarchive-tools \
    lsb-release \
    openssh-client \
    rpm \
    ruby \
    ruby-dev \
    sudo \
    tar \
    unzip \
    zip \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash runner \
  && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner \
  && chmod 0440 /etc/sudoers.d/runner

WORKDIR /home/runner/actions-runner

RUN set -eux; \
  runner_arch=""; \
  case "$(dpkg --print-architecture)" in \
    amd64) runner_arch=x64 ;; \
    arm64) runner_arch=arm64 ;; \
    armhf|arm) runner_arch=arm ;; \
    *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
  esac; \
  runner_version="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest | jq -r '.tag_name' | sed 's/^v//')"; \
  curl -fL -o /tmp/actions-runner.tar.gz "https://github.com/actions/runner/releases/download/v${runner_version}/actions-runner-linux-${runner_arch}-${runner_version}.tar.gz"; \
  tar -xzf /tmp/actions-runner.tar.gz; \
  rm /tmp/actions-runner.tar.gz; \
  ./bin/installdependencies.sh || true; \
  chown -R runner:runner /home/runner/actions-runner

COPY runner-entrypoint.sh /usr/local/bin/runner-entrypoint.sh
RUN chmod +x /usr/local/bin/runner-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/runner-entrypoint.sh"]
